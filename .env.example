# Copy to .env for local runs (.env is gitignored). In GitHub, set these as Actions secrets instead.
GOOGLE_SHEET_ID=
# Raw JSON of the service-account key, or a local path to the key file (keep it outside the repo).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional feeds
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GMAIL_OAUTH_CLIENT_JSON=
GMAIL_REFRESH_TOKEN=
